# Copy this file to ".env" (same folder) and fill in your own values.
# The ".env" file is private and is listed in .gitignore, so it is never uploaded to GitHub.

# Your PostgreSQL connection:  postgres://USERNAME:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=postgres://postgres:923345@localhost:5432/woober

# Long random text used to sign the login cookie
SESSION_SECRET=change-this-to-some-long-random-text

# The admin account. It is created automatically when the server starts.
ADMIN_EMAIL=admin@woober.com
ADMIN_PASSWORD=923345

# Optional (default is 3000)
PORT=3000
